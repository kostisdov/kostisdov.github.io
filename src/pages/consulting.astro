---
import Base from '../layouts/Base.astro';
import '../styles/rows.css';

const services = [
  {
    key: 'Architecture',
    text: 'Architecture and trade-off studies for tactical and UxV datalinks, from requirements to link and system budgets.',
  },
  {
    key: 'Waveforms',
    text: 'Waveform and modem design for harsh propagation environments, such as high-Doppler and low-SNR conditions.',
  },
  {
    key: 'DSP / FPGA',
    text: 'DSP and FPGA implementation of signal processing pipelines, from fixed-point models to RTL verification.',
  },
  {
    key: 'Arrays',
    text: 'Array signal processing: MIMO, adaptive beamforming, and direction finding.',
  },
  {
    key: 'MAC layer',
    text: 'MAC-layer design for link adaptation and power control.',
  },
  {
    key: 'Validation',
    text: 'System validation and characterization, from hardware-in-the-loop testing to field trials.',
  },
];
---

<Base
  title="Consulting — Kostis Dovelos"
  description="Dovelos Engineering: a wireless engineering consultancy serving defense, space, and telecom clients, from algorithm design and fixed-point modeling to DSP/FPGA implementation and field testing."
>
  <section class="about-grid">
    <article class="prose">
      <h2 class="section-head">Consulting</h2>
      <p style="margin-bottom: 0;">
        Dovelos Engineering is a wireless engineering consultancy serving defense, space, and
        telecom clients. Backed by a decade of academic research and industrial experience, we bridge
        the gap between mathematical theory and hardware, taking communications systems from algorithm
        design to DSP/FPGA implementation and field testing.
      </p>
    </article>
  </section>

  <section class="rows-section">
    <p class="rows-label">Services</p>
    <ul class="rows">
      {services.map((s) => (
        <li>
          <span class="key">{s.key}</span>
          <p>{s.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="rows-section">
    <p class="rows-label">RF digital twins</p>
    <ul class="rows">
      <li>
        <span class="key">Installed antennas</span>
        <div>
          <p>Full-wave EM simulation of arrays mounted on the airframe, to predict and calibrate direction-finding and beamforming performance.</p>
          <p class="see">See <a href="/posts/when-the-airframe-joins-the-array/">When the airframe joins the array</a></p>
        </div>
      </li>
      <li>
        <span class="key">Radio environment</span>
        <p>Site-specific ray tracing coupled with network simulation for coverage, link planning, and EW scenario analysis.</p>
      </li>
    </ul>
  </section>

  <section class="rows-section">
    <p class="rows-label">Engagement models</p>
    <ul class="rows">
      <li>
        <span class="key">Technical consulting</span>
        <p>Targeted architecture sprints, contract engineering, and technical advisory for next-generation wireless systems.</p>
      </li>
      <li>
        <span class="key">R&amp;D partnerships</span>
        <p>Joint proposals and consortium participation for ESA, EU, and national space and defense initiatives.</p>
      </li>
    </ul>
  </section>

  <div class="rows-cta">
    <p>Enquiries</p>
    <p class="see"><a href="mailto:konstantinos.dovelos@gmail.com">konstantinos.dovelos@gmail.com</a></p>
  </div>
</Base>
