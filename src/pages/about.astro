---
import Base from '../layouts/Base.astro';
import '../styles/rows.css';

const roles = [
  ['2026 - now', 'Senior DSP & Wireless Communications Engineer', 'KRUSH Labs', 'DSP, SDR development, and wireless communications engineering for next-generation UAV datalinks.'],
  ['2026 - now', 'Wireless Systems Architect', 'Dovelos Engineering', 'Wireless engineering consultancy for defense, space, and telecom clients.'],
  ['2024 - 2026', 'Senior Wireless Communications Engineer', 'Intracom Defense', 'PHY design of next-generation MANET radios for unmanned vehicles: waveform and modem design, MIMO, channel coding, link adaptation, LPD/LPI.'],
  ['2022 - 2024', 'Antenna Engineer', 'Meta Materials Inc.', 'Metamaterial-based solutions for 5G mmWave coverage; evolutionary optimization of anomalous reflectors.'],
  ['2021 - 2022', 'Postdoctoral Research Fellow', "Queen's University Belfast", 'Superdirectivity for energy-efficient mmWave/sub-THz massive MIMO (ERC project BEATRICE).'],
  ['2017 - 2021', 'Doctoral Researcher', 'Universitat Pompeu Fabra, Barcelona', 'Novel PHY techniques for 6G: ultra-massive MIMO processing, modeling of intelligent reflecting surfaces, interference alignment for dense networks.'],
  ['2015 - 2016', 'Research Intern', 'CTTC, Barcelona', 'Implemented a slotted ALOHA network using LoRa radios and STM32 microcontrollers.'],
  ['2014 - 2015', 'Graduate Research Assistant', 'EPFL, Lausanne', 'Investigated the finite-length performance of irregular repetition slotted ALOHA (IRSA).'],
];

const pubs: { year: string; title: string; authors: string; venue: string; href?: string }[] = [
  { year: '2026', title: 'OFDM with adaptive ICI-aware equalization for doubly dispersive channels', authors: 'K. Dovelos', venue: 'Preprint. Paper and code: github.com/kostisdov/ofdm_vs_otfs', href: 'https://github.com/kostisdov/ofdm_vs_otfs' },
  { year: '2023', title: 'Superdirective antenna pairs for energy-efficient terahertz massive MIMO', authors: 'K. Dovelos, S. D. Assimonis, H. Q. Ngo, and M. Matthaiou', venue: 'IEEE Trans. Commun.' },
  { year: '2022', title: 'Superdirective arrays with finite-length dipoles: Modeling and new perspectives', authors: 'K. Dovelos, S. D. Assimonis, H. Q. Ngo, and M. Matthaiou', venue: 'Proc. IEEE GLOBECOM' },
  { year: '2021', title: 'Channel estimation and hybrid combining for wideband terahertz massive MIMO systems', authors: 'K. Dovelos, M. Matthaiou, H. Q. Ngo, and B. Bellalta', venue: 'IEEE J. Sel. Areas Commun.' },
  { year: '2021', title: 'Intelligent reflecting surfaces at terahertz bands: Channel modeling and analysis', authors: 'K. Dovelos, S. D. Assimonis, H. Q. Ngo, B. Bellalta, and M. Matthaiou', venue: 'Proc. IEEE ICC Workshops' },
  { year: '2020', title: 'Massive MIMO with multi-antenna users under jointly correlated Ricean fading', authors: 'K. Dovelos, M. Matthaiou, H. Q. Ngo, and B. Bellalta', venue: 'Proc. IEEE ICC' },
];

const projects = [
  {
    name: 'Pyxida', href: 'https://pyxida.io', link: 'pyxida.io', meta: 'health · cardiology · 2026',
    text: "A personal companion that helps adults with congenital heart disease (CHD) navigate lifelong care with confidence and clarity. It brings a patient's multi-year medical history and care into one coherent, longitudinal picture, and provides appointment preparation and personalized physical-activity guidance.",
  },
  {
    name: 'FindMyHeart', href: 'https://github.com/kostisdov/FindMyHeart', link: 'GitHub', meta: 'health · metabolic · 2026',
    text: 'A cardiometabolic companion built for what generic fitness apps miss. It synthesizes your medical records and medication profile with real-time wearable data, delivering clinically contextualized feedback and personalized lifestyle interventions. Developed during LifeHack Athens 2026, a 36-hour life sciences hackathon at the heart of Panathēnea.',
  },
  {
    name: 'birdii', href: 'https://www.linkedin.com/company/birdii/', link: 'LinkedIn', meta: 'news · llms · 2025',
    text: 'An AI-native news app that redefines how we engage with news. Instead of static headlines, birdii turns each article into something you can interact: summaries, additional background information for unfamiliar topics, and a conversational Q&A that lets you ask follow-up questions and dig as deep as you want.',
  },
];
---

<Base
  title="About — Kostis Dovelos"
  description="Wireless systems architect and independent consultant in Athens, with an interest in computational cardiology and digital twins. Experience, selected publications, and side projects."
>
  <section class="about-grid">
    <article class="prose">
      <h2 class="section-head">Hello</h2>
      <p>
        I'm a wireless systems architect and independent consultant based in Athens, Greece. Through
        my consultancy, <a href="/consulting/">Dovelos Engineering</a>, I work with international
        companies on mission-critical wireless systems.
      </p>
      <p style="margin-bottom: 0;">
        Alongside my wireless work, I'm drawn to computational cardiology, especially how
        physics-informed neural networks and patient-specific digital twins can help optimize
        treatment planning and improve prognosis.
      </p>
    </article>
  </section>

  <section class="rows-section">
    <p class="rows-label">Experience</p>
    <ul class="rows">
      {roles.map(([when, role, org, what]) => (
        <li>
          <span class="key">{when}</span>
          <div>
            <p><strong>{role}</strong>, {org}</p>
            <p class="sub">{what}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="rows-section">
    <p class="rows-label">Selected publications</p>
    <ul class="rows">
      {pubs.map((p) => (
        <li>
          <span class="key">{p.year}</span>
          <div>
            <p>{p.href ? <a href={p.href}>{p.title}</a> : p.title}</p>
            <p class="sub">{p.authors}. <em>{p.venue}</em></p>
          </div>
        </li>
      ))}
    </ul>
    <p class="rows-more">
      <a href="https://scholar.google.com/citations?user=2kEnpJAAAAAJ&hl=en">Full list on Google Scholar →</a>
    </p>
  </section>

  <section class="rows-section">
    <p class="rows-label">AI side projects</p>
    <p style="margin: 0 0 1rem; max-width: 36rem;">
      In my spare time, I apply AI to problems that carry personal and societal weight. If
      you're interested in contributing, feel free to
      <a href="mailto:konstantinos.dovelos@gmail.com">drop me a line</a>.
    </p>
    <ul class="rows">
      {projects.map((p) => (
        <li>
          <span class="key"><a href={p.href}>{p.name} →</a></span>
          <div>
            <p>{p.text}</p>
            <p class="see">{p.meta} · <a href={p.href}>{p.link}</a></p>
          </div>
        </li>
      ))}
    </ul>
  </section>
</Base>
